---
import Logo from './Logo.astro';
import { NAV, SITE } from '../lib/site';

const year = new Date().getFullYear();
---

<footer class="footer on-lime">
  <div class="kerb" aria-hidden="true"><div class="kerb__run" data-kerb></div></div>

  <div class="wrap footer__top">
    <div class="footer__col">
      <p class="mono">pages</p>
      <ul data-reveal="stagger">
        <li><a class="footer__link" href="/">home</a></li>
        {NAV.map((item) => <li><a class="footer__link" href={item.href}>{item.label}</a></li>)}
      </ul>
    </div>
    <div class="footer__col">
      <p class="mono">follow</p>
      <ul data-reveal="stagger">
        <li><a class="footer__link" href="/rss.xml" data-astro-reload>RSS feed</a></li>
      </ul>
    </div>
    <div class="footer__col footer__note">
      <p class="mono">pit wall</p>
      <p class="serif">
        written in riyadh by one fan. not affiliated with formula 1, the FIA or any team.
      </p>
      <p class="mono footer__clock">riyadh <span data-clock>--:--</span></p>
    </div>
  </div>

  <a class="footer__author" href={SITE.authorUrl} target="_blank" rel="noopener author" data-fill data-cursor="visit">
    <span class="fill" aria-hidden="true"></span>
    <span class="wrap footer__author-in">
      <span class="mono">written by</span>
      <span class="footer__author-name">{SITE.author.toLowerCase()}</span>
      <span class="mono">{new URL(SITE.authorUrl).hostname.replace('www.', '')}</span>
      <span class="footer__author-arrow" aria-hidden="true">
        <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M5 19 19 5M8 5h11v11"></path>
        </svg>
      </span>
    </span>
  </a>

  <div class="footer__word" aria-hidden="true">
    <span class="display" data-footer-word>downforce</span>
  </div>

  <div class="wrap footer__base">
    <a href="/" class="footer__home" aria-label="the downforce blog, home"><Logo size={36} ground="#f2ecdf" /></a>
    <p class="mono">© {year} the downforce blog</p>
    <a href="#top" class="mono footer__top-link" data-to-top>back to top</a>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    overflow: hidden;
  }

  .footer__top {
    border-bottom: var(--rule) solid var(--ink);
    display: grid;
    grid-template-columns: 1fr 1fr 2fr;
    gap: 2rem;
    padding-block: clamp(3.5rem, 7vw, 6rem) clamp(2rem, 4vw, 3rem);
  }
  .footer__col > .mono {
    margin-bottom: 1rem;
    color: var(--mute);
  }
  .footer__link {
    display: inline-block;
    font-weight: 800;
    font-stretch: 112%;
    font-size: clamp(1.5rem, 2.6vw, 2.4rem);
    letter-spacing: -0.04em;
    line-height: 1.12;
    transition: transform 0.35s var(--ease-out);
  }
  .footer__link:hover {
    transform: translateX(0.5rem);
  }
  .footer__note .serif {
    max-width: 30ch;
    font-size: clamp(1.15rem, 1.6vw, 1.45rem);
    font-style: italic;
    line-height: 1.3;
  }
  .footer__clock {
    margin-top: 1.25rem;
  }

  .footer__author {
    position: relative;
    display: block;
    overflow: hidden;
    isolation: isolate;
    transition: color 0.3s var(--ease-out);
  }
  .footer__author .fill {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--ink);
    transform: translateY(101%);
  }
  .footer__author:focus-visible {
    color: var(--paper);
    outline-color: var(--paper);
    outline-offset: -8px;
  }
  /* touch and keyboard never run the pointer script, so give them the fill in CSS */
  .footer__author:focus-visible .fill {
    transform: none;
  }
  @media (hover: hover) {
    .footer__author:hover,
    .footer__author:hover .mono {
      color: var(--paper);
    }
  }
  @media (hover: none) {
    .footer__author:active,
    .footer__author:active .mono {
      color: var(--paper);
    }
    .footer__author:active .fill {
      transform: none;
    }
  }
  .footer__author-in {
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    align-items: center;
    gap: clamp(1rem, 2.5vw, 2.5rem);
    padding-block: clamp(1.75rem, 3.5vw, 3rem);
  }
  .footer__author .mono {
    color: var(--mute);
    transition: color 0.3s var(--ease-out);
  }
  .footer__author:focus-visible .mono {
    color: var(--paper);
  }
  .footer__author-name {
    font-weight: 880;
    font-stretch: 112%;
    font-size: clamp(2.4rem, 6.4vw, 6.25rem);
    letter-spacing: -0.045em;
    line-height: 0.95;
  }
  .footer__author-arrow {
    display: block;
    width: clamp(2rem, 4vw, 3.5rem);
    aspect-ratio: 1;
    overflow: hidden;
  }
  .footer__author-arrow svg {
    width: 100%;
    height: 100%;
  }

  .footer__word {
    container-type: inline-size;
    margin-inline: var(--gutter);
    overflow: hidden;
  }
  .footer__word span {
    display: block;
    font-size: calc(100cqi / 6.62);
    line-height: 0.9;
    padding-bottom: 0.08em;
    white-space: nowrap;
  }

  .footer__base {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding-block: 1.25rem;
    border-top: var(--rule) solid var(--ink);
  }
  .footer__home :global(svg) {
    border: var(--rule) solid var(--ink);
  }
  .footer__top-link {
    margin-left: auto;
    padding: 0.5rem 0;
    border-bottom: var(--rule) solid var(--ink);
    transition: opacity 0.2s;
  }
  .footer__top-link:hover {
    opacity: 0.6;
  }

  @media (max-width: 800px) {
    .footer__top {
      grid-template-columns: 1fr 1fr;
    }
    .footer__note {
      grid-column: 1 / -1;
    }
    .footer__author-in {
      grid-template-columns: 1fr auto;
      row-gap: 0.6rem;
    }
    .footer__author-name {
      grid-column: 1 / -1;
    }
    .footer__author .mono:first-child {
      grid-column: 1 / -1;
    }
  }
</style>
