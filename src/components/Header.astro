---
import Logo from './Logo.astro';
import { NAV } from '../lib/site';

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<header class="site-header" data-header>
  <div class="bar on-paper">
    <a href="/" class="brand" aria-label="the downforce blog, home" data-cursor="home">
      <Logo size={44} class="brand__mark" />
      <span class="brand__word display" aria-hidden="true">downforce</span>
    </a>

    <nav class="nav" aria-label="main">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} class="nav__link mono" aria-current={isCurrent(item.href) ? 'page' : undefined} data-roll>
                <span class="roll">
                  <span class="roll__a">{item.label}</span>
                  <span class="roll__b" aria-hidden="true">
                    {item.label}
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a href="/standings/" class="next mono" aria-label="next race, see standings">
      <span class="next__dot" aria-hidden="true"></span>
      <span data-f1="next-short">next race</span>
    </a>

    <span class="progress" data-progress aria-hidden="true"></span>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    padding: max(clamp(0.5rem, 1.2vw, 1rem), env(safe-area-inset-top)) var(--gutter) 0;
    pointer-events: none;
  }

  .bar {
    position: relative;
    display: flex;
    align-items: stretch;
    height: var(--header-h);
    max-width: calc(var(--max) - 2 * var(--gutter));
    margin-inline: auto;
    border: var(--rule) solid var(--ink);
    box-shadow: 5px 5px 0 var(--ink);
    pointer-events: auto;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0 1.1rem 0 0.7rem;
    border-right: var(--rule) solid var(--ink);
  }
  .brand :global(.brand__mark) {
    border: var(--rule) solid var(--ink);
  }
  .brand__word {
    font-size: 1.35rem;
    letter-spacing: -0.05em;
    line-height: 1;
    padding-bottom: 0.12em;
  }

  .nav {
    display: flex;
    flex: 1;
  }
  .nav ul {
    display: flex;
    align-items: stretch;
  }
  .nav li {
    display: flex;
  }
  .nav__link {
    position: relative;
    display: flex;
    align-items: center;
    padding: 0 clamp(0.8rem, 1.6vw, 1.5rem);
    font-size: 0.8125rem;
    transition: background-color 0.25s var(--ease-out);
  }
  .nav__link:hover {
    background: var(--paper-dim);
  }
  .nav__link:active {
    background: var(--lime);
  }
  .nav__link[aria-current='page']::after {
    content: '';
    position: absolute;
    left: clamp(0.8rem, 1.6vw, 1.5rem);
    right: clamp(0.8rem, 1.6vw, 1.5rem);
    bottom: 1rem;
    height: 3px;
    background: var(--lime-deep);
  }

  .roll {
    position: relative;
    display: block;
    overflow: hidden;
    line-height: 1.5;
  }
  .roll__a,
  .roll__b {
    display: block;
  }
  .roll__b {
    position: absolute;
    inset: 0;
    transform: translateY(105%);
  }

  .next {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0 1.2rem;
    background: var(--lime);
    border-left: var(--rule) solid var(--ink);
    white-space: nowrap;
    transition: background-color 0.25s var(--ease-out), color 0.25s var(--ease-out);
  }
  .next:hover {
    background: var(--ink);
    color: var(--paper);
  }
  .next:active {
    background: var(--teal-800);
  }
  .next__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: currentColor;
  }

  .progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 4px;
    background: var(--lime);
    transform: scaleX(0);
    transform-origin: left center;
  }

  @media (max-width: 720px) {
    .brand__word {
      display: none;
    }
    .brand {
      padding: 0 0.6rem;
    }
    .next {
      display: none;
    }
    .nav ul {
      width: 100%;
      justify-content: flex-end;
    }
  }
</style>
