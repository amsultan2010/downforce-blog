---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Analytics from '@vercel/analytics/astro';
import displayFont from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Logo from '../components/Logo.astro';
import { SITE } from '../lib/site';
import { getBuildF1 } from '../lib/f1-build';

interface Props {
  /** page name; omit on the homepage */
  title?: string;
  description?: string;
  /** site-relative path to a 1200x630 image */
  ogImage?: string;
  article?: { published: Date; tags: string[] };
  noindex?: boolean;
}

const { title, description = SITE.description, ogImage = '/og/default.png', article, noindex = false } = Astro.props;

const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} | formula 1 race reports and opinions`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogUrl = new URL(ogImage, Astro.site).href;
const f1 = await getBuildF1();

const siteLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': new URL('/#website', Astro.site).href,
      url: new URL('/', Astro.site).href,
      name: SITE.name,
      description: SITE.description,
      inLanguage: 'en',
      publisher: { '@id': new URL('/#author', Astro.site).href },
    },
    {
      '@type': 'Person',
      '@id': new URL('/#author', Astro.site).href,
      name: SITE.author,
      url: new URL('/about/', Astro.site).href,
      sameAs: [SITE.authorUrl],
    },
  ],
};
---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0a3940" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    {article && <meta property="article:published_time" content={article.published.toISOString()} />}
    {article?.tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(siteLd)} />
    <slot name="head" />

    <!-- Motion gate. Runs before first paint: content is only hidden for its entrance when
         motion is allowed, and a timer puts it back if the main script never arrives. -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        // The curtain in src/lib/motion/boot.ts covers route changes, so the browser's own
        // view-transition snapshots are not wanted: hiding the API makes the router do a
        // plain DOM swap, which cannot stall when the tab is not painting.
        document.startViewTransition = undefined;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        d.classList.add('js-motion');
        try {
          if (!sessionStorage.getItem('df-seen')) d.classList.add('is-first');
        } catch (e) {}
        window.__dfFailsafe = setTimeout(function () {
          d.classList.remove('js-motion', 'is-first');
        }, 4000);
      })();
    </script>

    <ClientRouter fallback="swap" />
  </head>

  <body id="top">
    <a class="skip-link mono" href="#main">skip to content</a>

    <div class="curtain" data-curtain aria-hidden="true" transition:persist="curtain">
      <div class="curtain__panel" data-curtain-panel>
        <div class="curtain__mark" data-curtain-mark><Logo size={84} /></div>
        <div class="curtain__lights" data-curtain-lights>
          {[0, 1, 2, 3, 4].map(() => <span data-light />)}
        </div>
      </div>
    </div>

    <div class="cursor" data-cursor-el aria-hidden="true" transition:persist="cursor">
      <span class="mono" data-cursor-label></span>
    </div>

    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer />

    <script type="application/json" id="f1-data" is:inline set:html={JSON.stringify(f1)} />
    <Analytics />
  </body>
</html>

<script>
  import { boot } from '../lib/motion/boot';
  boot();
</script>

<style is:global>
  .curtain {
    position: fixed;
    inset: 0;
    z-index: 200;
    visibility: hidden;
    pointer-events: none;
  }
  .is-first .curtain {
    visibility: visible;
  }
  .curtain__panel {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: var(--teal-950);
    border-block: 14px solid var(--lime);
  }
  .curtain__mark,
  .curtain__lights {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
  }
  .is-first .curtain__lights {
    opacity: 1;
    visibility: visible;
  }
  .curtain__lights {
    display: flex;
    gap: clamp(0.6rem, 2vw, 1.4rem);
    padding: clamp(0.8rem, 2vw, 1.4rem);
    border: var(--rule) solid var(--paper);
  }
  .curtain__lights span {
    width: clamp(1.6rem, 5vw, 3.2rem);
    aspect-ratio: 1;
    border: var(--rule) solid var(--paper);
    border-radius: 999px;
  }

  .cursor {
    --cursor-size: 0.75rem;
    position: fixed;
    top: 0;
    left: 0;
    z-index: 150;
    display: grid;
    place-items: center;
    width: var(--cursor-size);
    height: var(--cursor-size);
    margin: calc(var(--cursor-size) / -2) 0 0 calc(var(--cursor-size) / -2);
    border-radius: 999px;
    background: var(--lime);
    color: var(--ink);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    mix-blend-mode: normal;
  }
  .cursor[data-state='link'] {
    background: transparent;
    border: var(--rule) solid var(--lime);
  }
  .cursor span {
    font-size: 0.6875rem;
    font-weight: 700;
    white-space: nowrap;
    opacity: 0;
    transition: opacity 0.15s;
  }
  .cursor[data-state='label'] span {
    opacity: 1;
  }
  @media not ((hover: hover) and (pointer: fine)) {
    .cursor {
      display: none;
    }
  }
</style>
