---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPosts } from '../lib/posts';
import race3 from '../assets/site/race3.jpg';

const posts = await getPosts();
const first = posts[posts.length - 1];
const since = first ? first.data.date.getUTCFullYear() : new Date().getFullYear();
---

<BaseLayout
  title="about"
  description="who writes the downforce blog: a high schooler in riyadh, an aston martin fan, and a firm believer that fernando alonso is the greatest of all time."
>
  <section class="top on-teal" data-intro>
    <div class="wrap">
      <p class="eyebrow mono" data-reveal="up">who writes this</p>
      <h1 class="h-xl display" data-split="chars">about</h1>
      <p class="lede" data-split="lines">
        i'm a high schooler in riyadh who has loved formula 1 for as long as i can remember. this is where i write about
        it.
      </p>
    </div>
  </section>

  <section class="body on-paper">
    <div class="wrap body__grid">
      <div class="prose">
        <p data-split="lines">
          i started the downforce blog since i wanted a place to put my actual thoughts on races, not just repost what
          everyone else was saying. F1 is the most technically complex, politically messy and exciting sport on the
          planet, and most coverage doesn't do it justice.
        </p>
        <p data-split="lines">
          i'm a massive aston martin fan and an even bigger fernando alonso fan. the man is the greatest driver of all
          time and i will not be taking questions. that bias shows up in the writing. so does everything else i think
          about the sport.
        </p>
        <p data-split="lines">
          posts go up after race weekends, plus editorials and hot takes whenever something in the paddock is worth
          reacting to.
        </p>
      </div>

      <aside class="side">
        <figure class="frame" data-reveal="clip">
          <Image
            src={race3}
            alt="the start of a night race seen from above, the cars fanning out across the track"
            widths={[480, 800]}
            sizes="(min-width: 900px) 30vw, 92vw"
            data-parallax="6"
          />
        </figure>

        <dl class="facts" data-reveal="stagger">
          <div>
            <dt class="mono">based in</dt>
            <dd>riyadh, saudi arabia</dd>
          </div>
          <div>
            <dt class="mono">writing since</dt>
            <dd>{since}</dd>
          </div>
          <div>
            <dt class="mono">posts so far</dt>
            <dd><span data-count={posts.length}>{posts.length}</span></dd>
          </div>
          <div>
            <dt class="mono">team</dt>
            <dd>aston martin</dd>
          </div>
          <div>
            <dt class="mono">follow</dt>
            <dd><a class="link" href="/rss.xml" data-astro-reload>RSS feed</a></dd>
          </div>
        </dl>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .top {
    padding-top: calc(var(--header-h) + clamp(4rem, 9vw, 9rem));
    padding-bottom: clamp(3rem, 6vw, 6rem);
  }
  .top .eyebrow {
    margin-bottom: 1.5rem;
  }
  .top .lede {
    max-width: 30ch;
    margin-top: clamp(2rem, 4vw, 4rem);
  }

  .body {
    padding-block: clamp(3.5rem, 8vw, 8rem) clamp(5rem, 10vw, 10rem);
  }
  .body__grid {
    display: grid;
    grid-template-columns: minmax(0, 40rem) minmax(0, 26rem);
    justify-content: space-between;
    gap: clamp(2.5rem, 6vw, 7rem);
    align-items: start;
  }

  .side .frame {
    aspect-ratio: 4 / 3;
    box-shadow: 8px 8px 0 var(--lime);
  }
  .side .frame :global(img) {
    position: absolute;
    top: -8%;
    left: 0;
    height: 116%;
  }
  .facts {
    margin-top: 2.75rem;
    border-top: var(--rule) solid var(--ink);
  }
  .facts > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--ink);
  }
  .facts dt {
    color: var(--mute);
  }
  .facts dd {
    font-weight: 760;
    font-stretch: 108%;
    letter-spacing: -0.02em;
    text-align: right;
  }

  @media (max-width: 899px) {
    .body__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
