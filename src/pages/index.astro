---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostRow from '../components/PostRow.astro';
import Standings from '../components/Standings.astro';
import Logo from '../components/Logo.astro';
import { CATEGORY_LABEL, CATEGORY_PLURAL, formatDate, getPosts, isoDate, postUrl, readingTime, type Category } from '../lib/posts';
import { getBuildF1 } from '../lib/f1-build';
import { f1Text } from '../lib/f1-render';
import heroImg from '../assets/site/hero.jpg';
import race1 from '../assets/site/race1.jpg';
import race2 from '../assets/site/race2.jpg';
import race3 from '../assets/site/race3.jpg';
import race4 from '../assets/site/race4.jpg';

const posts = await getPosts();
const [feature, ...rest] = posts;
const rows = rest.slice(0, 5);

const f1 = await getBuildF1();
const live = f1Text(f1);

const fallbacks = [race2, race4, race1, race3];
const featureImg = feature?.data.thumbnail ?? fallbacks[0];
const featureAlt = feature?.data.thumbnail ? (feature.data.thumbnailAlt ?? '') : '';

const archive = (['race-report', 'sprint-report', 'editorial', 'guide', 'paddock'] as Category[])
  .map((cat) => ({ cat, count: posts.filter((p) => p.data.category === cat).length }))
  .filter((c) => c.count > 0);

const photos = [
  { src: race2, alt: 'the whole field streams towards the first corner at the start of a race, a ferrari in front' },
  { src: race4, alt: 'a mercedes leads a red bull through a floodlit corner' },
  { src: race1, alt: 'four cars squeeze through a corner side by side under floodlights' },
  { src: race3, alt: 'the start of a night race seen from above, the cars fanning out across the track' },
];

const ticker = ['race reports', 'sprint reports', 'editorials', 'guides', 'paddock stories', 'live standings'];
---

<BaseLayout>
  <section class="hero on-green" data-hero data-intro>
    <div class="hero__grid" data-hero-grid aria-hidden="true"></div>
    <svg class="hero__line" data-hero-line viewBox="0 0 1200 620" fill="none" aria-hidden="true">
      <path
        data-draw
        data-at="0.5"
        d="M80 420C80 300 160 220 300 220h220c80 0 120-60 200-80 100-25 180-80 290-50s140 150 70 210c-50 45-140 30-180 80s0 120-80 150c-100 38-180-60-280-50s-140 80-260 70S80 500 80 420Z"
        stroke="#e84a25"
        stroke-width="2.5"></path>
      <path
        data-hero-car
        d="M80 420C80 300 160 220 300 220h220c80 0 120-60 200-80 100-25 180-80 290-50s140 150 70 210c-50 45-140 30-180 80s0 120-80 150c-100 38-180-60-280-50s-140 80-260 70S80 500 80 420Z"
        stroke="#f2ecdf"
        stroke-width="5"
        stroke-linecap="round"></path>
    </svg>

    <div class="wrap hero__inner">
      <ul class="hero__strip mono" data-reveal="stagger" data-at="0.9">
        <li>riyadh <span data-clock>--:--</span></li>
        <li data-f1="season">{live.season}</li>
        <li data-f1="leader">{live.leader}</li>
        <li class="hero__live"><i aria-hidden="true"></i>live standings</li>
      </ul>

      <h1 class="hero__title">
        <span class="hero__the mono" data-reveal="up" data-at="0.15">the</span>
        <span class="hero__word display" data-hero-word><span data-split="chars" data-at="0">downforce</span></span>
        <span class="hero__blog serif-accent" data-split="chars" data-at="0.45">blog</span>
      </h1>

      <div class="hero__lower">
        <div class="hero__copy">
          <p class="lede" data-split="lines" data-at="0.7">
            formula 1 race reports and opinions, written from riyadh by a fan who watches every session.
          </p>
          <div class="hero__cta" data-reveal="stagger" data-at="1.05">
            {
              feature && (
                <a class="btn btn--accent" href={postUrl(feature)} data-magnetic>
                  read the latest
                  <span class="btn__arrow" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                      <path d="M5 19 19 5M8 5h11v11" />
                    </svg>
                  </span>
                </a>
              )
            }
            <a class="btn btn--ghost" href="#standings" data-magnetic>see the standings</a>
          </div>
        </div>

        <figure class="hero__media frame" data-hero-media data-reveal="clip" data-at="0.55">
          <Image
            src={heroImg}
            alt="a pack of formula 1 cars funnels into a first corner, a red bull ahead of two mclarens and a ferrari"
            widths={[640, 960, 1440]}
            sizes="(min-width: 900px) 46vw, 92vw"
            loading="eager"
            fetchpriority="high"
          />
        </figure>
      </div>
    </div>

    <a href="#latest" class="hero__cue mono" data-hero-cue data-reveal="up" data-at="1.4">
      scroll <i aria-hidden="true"></i>
    </a>
  </section>

  <div class="ticker on-orange" aria-hidden="true">
    <div class="ticker__track" data-marquee>
      {
        [0, 1].map(() => (
          <div class="ticker__set">
            {ticker.map((item) => (
              <>
                <span class="ticker__item display">{item}</span>
                <Logo size={34} class="ticker__mark" ground="#f2ecdf" />
              </>
            ))}
          </div>
        ))
      }
    </div>
  </div>

  <section class="section on-paper" id="latest">
    <div class="wrap">
      <header class="head">
        <p class="eyebrow mono">sector 01 / latest</p>
        <h2 class="h-lg" data-split="chars">latest <span class="serif-accent">posts</span></h2>
      </header>

      {
        feature && (
          <article class="feature">
            <a href={postUrl(feature)} class="feature__media frame" data-reveal="clip-left" data-tilt data-cursor="read" tabindex="-1" aria-hidden="true">
              <Image src={featureImg} alt={featureAlt} widths={[640, 960, 1400]} sizes="(min-width: 900px) 56vw, 92vw" data-parallax="6" />
            </a>
            <div class="feature__body">
              <p class="mono feature__meta" data-reveal="up">
                <span class="tag">{CATEGORY_LABEL[feature.data.category]}</span>
                <time datetime={isoDate(feature.data.date)}>{formatDate(feature.data.date)}</time>
                <span>{readingTime(feature.body)} min read</span>
              </p>
              <h3 class="h-md feature__title">
                <a href={postUrl(feature)} data-split="lines">{feature.data.title}</a>
              </h3>
              <p class="serif feature__excerpt" data-split="lines">{feature.data.excerpt}</p>
              <div data-reveal="up">
                <a class="btn" href={postUrl(feature)} data-magnetic>
                  read the post
                  <span class="btn__arrow" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                      <path d="M5 19 19 5M8 5h11v11" />
                    </svg>
                  </span>
                </a>
              </div>
            </div>
          </article>
        )
      }

      <span class="rule" data-rule></span>
      <ol class="rows" data-reveal="stagger">
        {rows.map((post, i) => <PostRow post={post} index={i + 2} />)}
      </ol>

      <div class="more" data-reveal="up">
        <a class="btn btn--accent" href="/posts/" data-magnetic>all {posts.length} posts</a>
      </div>
    </div>
  </section>

  <section class="manifesto on-green" data-manifesto>
    <div class="manifesto__inner">
      <div class="wrap">
        <p class="eyebrow mono">sector 02 / what this is</p>
        <p class="manifesto__text" data-manifesto-text>
          race reports with a point of view, from a fan in riyadh who watches every session and has an opinion about all
          of them.
        </p>
      </div>
      <div class="manifesto__track" data-manifesto-track>
        {
          photos.map((photo, i) => (
            <figure class="frame">
              <Image src={photo.src} alt={photo.alt} widths={[640, 1000]} sizes="(min-width: 900px) 44vw, 80vw" />
              <figcaption class="mono">
                {String(i + 1).padStart(2, '0')} / {String(photos.length).padStart(2, '0')}
              </figcaption>
            </figure>
          ))
        }
      </div>
      <span class="manifesto__bar" data-manifesto-bar aria-hidden="true"></span>
    </div>
  </section>

  <section class="section section--tight on-paper">
    <div class="wrap">
      <header class="head head--split">
        <div>
          <p class="eyebrow mono">sector 03 / the archive</p>
          <h2 class="h-lg" data-split="chars">pick a <span class="serif-accent">lane</span></h2>
        </div>
        <p class="serif head__note" data-split="lines">
          {posts.length} posts since october 2025, sorted by what kind of mood you are in.
        </p>
      </header>

      <span class="rule" data-rule></span>
      <ul class="lanes">
        {
          archive.map(({ cat, count }) => (
            <li>
              <a href={`/posts/?c=${cat}`} class="lane" data-fill data-cursor="open">
                <span class="fill" aria-hidden="true" />
                <span class="lane__name display">{CATEGORY_PLURAL[cat]}</span>
                <span class="lane__count">
                  <span class="lane__num display" data-count={count}>
                    {count}
                  </span>
                  <span class="mono">{count === 1 ? 'post' : 'posts'}</span>
                </span>
              </a>
              <span class="rule" data-rule />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section standings on-deep" id="standings">
    <div class="standings__grid" aria-hidden="true"></div>
    <div class="wrap">
      <header class="head head--split">
        <div>
          <p class="eyebrow mono">sector 04 / championship</p>
          <h2 class="h-lg" data-split="chars">the <span class="serif-accent">standings</span></h2>
        </div>
        <div class="standings__meta">
          <p class="mono"><i class="pulse" aria-hidden="true"></i><span data-f1="after">{live.after}</span></p>
          <p class="mono mono--mute">live from the results API. top ten drivers shown.</p>
        </div>
      </header>

      <Standings drivers={10} />

      <div class="next" data-reveal="clip">
        <div class="next__main">
          <p class="mono">next race <span data-f1="next-countdown"></span></p>
          <p class="next__name display" data-f1="next-name">{live['next-name']}</p>
          <p class="mono" data-f1="next-when">{live['next-when']}</p>
        </div>
        <a class="btn" href="/standings/" data-magnetic>full standings</a>
      </div>
    </div>
  </section>

  <div class="peek frame" data-peek-box aria-hidden="true"><img alt="" width="280" height="187" /></div>
</BaseLayout>

<style>
  /* hero */
  .hero {
    position: relative;
    min-height: 100svh;
    padding-top: calc(var(--header-h) + clamp(2rem, 5vw, 4.5rem));
    padding-bottom: clamp(4rem, 7vw, 6rem);
    overflow: hidden;
  }
  .hero__grid {
    position: absolute;
    inset: -10% 0;
    background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: clamp(3rem, 6vw, 6rem) clamp(3rem, 6vw, 6rem);
    opacity: 0.45;
    mask-image: linear-gradient(to bottom, #000 40%, transparent);
  }
  .hero__line {
    position: absolute;
    right: -8%;
    top: 14%;
    width: min(78vw, 76rem);
    height: auto;
    opacity: 0.55;
    overflow: visible;
  }
  .hero__inner {
    position: relative;
  }

  .hero__strip {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2.25rem;
    padding-block: 0.8rem;
    border-block: 1px solid var(--line);
    color: var(--mute);
  }
  .hero__live {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-left: auto;
    color: var(--fg);
  }
  .hero__live i,
  .pulse {
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    margin-right: 0.5rem;
    border-radius: 999px;
    background: var(--orange);
    animation: pulse 1.8s ease-in-out infinite;
  }
  .hero__live i {
    margin-right: 0;
  }
  @keyframes pulse {
    50% {
      opacity: 0.25;
    }
  }

  .hero__title {
    position: relative;
    container-type: inline-size;
    margin-top: clamp(1.5rem, 3.5vw, 3.5rem);
    font-weight: inherit;
    letter-spacing: 0;
  }
  .hero__the {
    display: block;
    margin-left: 0.4em;
    font-size: clamp(0.8rem, 1.3vw, 1.1rem);
    color: var(--accent-text);
  }
  .hero__word {
    display: block;
    margin-left: -0.045em;
    /* the word is 6.54em wide, so this sets it to the full width of the column */
    font-size: calc(100cqi / 6.62);
    white-space: nowrap;
  }
  .hero__blog {
    position: absolute;
    right: 0;
    bottom: -0.6em;
    font-size: clamp(2.6rem, 9.5cqi, 10rem);
    line-height: 1;
    color: var(--orange);
  }

  .hero__lower {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: end;
    margin-top: clamp(3.5rem, 8vw, 8rem);
  }
  .hero__copy .lede {
    max-width: 24ch;
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 1.1rem;
    margin-top: clamp(1.75rem, 3vw, 2.75rem);
  }
  .hero__media {
    aspect-ratio: 16 / 9;
    /* bleeds off the right edge of the viewport */
    margin-right: calc(var(--gutter) * -1 - max(0px, (100vw - var(--max)) / 2));
    border-color: var(--paper);
    border-right: 0;
  }
  .hero__media :global(img) {
    position: absolute;
    top: -16%;
    left: 0;
    height: 116%;
  }

  .hero__cue {
    position: absolute;
    left: var(--gutter);
    bottom: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--mute);
  }
  .hero__cue i {
    display: block;
    width: 1px;
    height: 2rem;
    background: currentColor;
  }

  /* ticker */
  .ticker {
    overflow: hidden;
    border-block: var(--rule) solid var(--ink);
  }
  .ticker__track {
    display: flex;
    width: max-content;
    will-change: transform;
  }
  .ticker__set {
    display: flex;
    align-items: center;
    gap: clamp(1.5rem, 3vw, 3rem);
    padding: 0.9rem clamp(0.75rem, 1.5vw, 1.5rem);
  }
  .ticker__item {
    font-size: clamp(1.6rem, 3.4vw, 3rem);
    line-height: 1;
    white-space: nowrap;
    padding-bottom: 0.1em;
  }
  .ticker :global(.ticker__mark) {
    flex: none;
    border: var(--rule) solid var(--ink);
  }

  /* section heads */
  .head {
    display: grid;
    gap: 1.25rem;
    margin-bottom: clamp(2.5rem, 5vw, 5rem);
  }
  .head--split {
    grid-template-columns: 1fr auto;
    align-items: end;
    column-gap: 3rem;
  }
  .head .eyebrow {
    margin-bottom: 1.25rem;
  }
  .head__note {
    max-width: 26ch;
    font-size: clamp(1.1rem, 1.5vw, 1.4rem);
    font-style: italic;
    line-height: 1.3;
    color: var(--mute);
  }

  /* feature */
  .feature {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(1.75rem, 4vw, 4.5rem);
    align-items: end;
    margin-bottom: clamp(3rem, 6vw, 6rem);
  }
  .feature__media {
    display: block;
    aspect-ratio: 3 / 2;
    box-shadow: 10px 10px 0 var(--ink);
  }
  .feature__media :global(img) {
    position: absolute;
    top: -8%;
    left: 0;
    height: 116%;
  }
  .feature__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    color: var(--mute);
  }
  .feature__meta .tag {
    color: var(--fg);
  }
  .feature__title {
    margin-block: 1.1rem 1rem;
  }
  .feature__title a {
    display: block;
  }
  .feature__excerpt {
    max-width: 38ch;
    margin-bottom: 2rem;
    font-size: clamp(1.15rem, 1.5vw, 1.4rem);
    line-height: 1.4;
  }

  .more {
    margin-top: clamp(2rem, 4vw, 3.5rem);
  }

  /* manifesto: the pinned set piece */
  .manifesto {
    position: relative;
    overflow: hidden;
  }
  .manifesto__inner {
    position: relative;
    display: grid;
    /* minmax(0, ...) stops the max-content photo track from widening the column */
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto minmax(0, 1fr);
    gap: clamp(1.5rem, 4vh, 3rem);
    height: 100svh;
    padding-block: calc(var(--header-h) + 2.5rem) 2.75rem;
  }
  .manifesto__text {
    margin-top: 1.5rem;
    max-width: 27ch;
    font-weight: 880;
    font-stretch: 108%;
    font-size: clamp(1.9rem, 4.4vw, 4.75rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }
  .manifesto__track {
    display: flex;
    align-items: stretch;
    gap: clamp(1rem, 2.5vw, 2.5rem);
    width: max-content;
    padding-inline: var(--gutter);
  }
  .manifesto__track figure {
    position: relative;
    flex: none;
    height: 100%;
    aspect-ratio: 16 / 10;
    border-color: var(--paper);
  }
  .manifesto__track :global(img) {
    width: 124%;
    max-width: none;
    margin-left: -12%;
  }
  .manifesto__track figcaption {
    position: absolute;
    left: 0;
    bottom: 0;
    padding: 0.45rem 0.7rem;
    background: var(--paper);
    color: var(--ink);
  }
  .manifesto__bar {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 6px;
    background: var(--orange);
    transform: scaleX(0);
    transform-origin: left center;
  }
  @media (max-width: 899px) {
    .manifesto__inner {
      height: auto;
      padding-block: clamp(4.5rem, 12vw, 7rem);
    }
    .manifesto__text {
      max-width: none;
    }
    .manifesto__track {
      width: auto;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }
    .manifesto__track figure {
      width: 80vw;
      height: auto;
      scroll-snap-align: center;
    }
    .manifesto__bar {
      display: none;
    }
  }

  /* archive lanes */
  .lane {
    position: relative;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    padding: clamp(0.9rem, 2vw, 1.6rem) clamp(0.25rem, 1vw, 1rem);
    overflow: hidden;
    isolation: isolate;
  }
  .lane .fill {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--ink);
    transform: translateY(101%);
  }
  .lane:hover,
  .lane:focus-visible {
    color: var(--paper);
  }
  .lane:focus-visible .fill {
    transform: none;
  }
  .lane {
    transition: color 0.3s var(--ease-out);
  }
  .lane__name {
    font-size: clamp(2.2rem, 7.4vw, 8rem);
    line-height: 0.95;
    padding-bottom: 0.08em;
    transition: transform 0.5s var(--ease-out);
  }
  .lane:hover .lane__name {
    transform: translateX(clamp(0.5rem, 2vw, 2rem));
  }
  .lane__count {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    flex: none;
  }
  .lane__num {
    font-size: clamp(1.6rem, 3.6vw, 3.6rem);
    color: var(--accent-text);
    font-variant-numeric: tabular-nums;
  }
  .lane:hover .lane__num {
    color: var(--orange);
  }

  /* standings */
  .standings {
    overflow: hidden;
  }
  .standings__grid {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 5rem 5rem;
    opacity: 0.3;
  }
  .standings .wrap {
    position: relative;
  }
  .standings__meta {
    display: grid;
    gap: 0.5rem;
    max-width: 22rem;
  }

  .next {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-top: clamp(3rem, 6vw, 6rem);
    padding: clamp(1.5rem, 3vw, 3rem);
    background: var(--orange);
    color: var(--ink);
    border: var(--rule) solid var(--ink);
    --shadow: var(--ink);
  }
  .next__main {
    display: grid;
    gap: 0.6rem;
  }
  .next__name {
    font-size: clamp(1.9rem, 5vw, 5rem);
    line-height: 0.92;
    padding-bottom: 0.06em;
  }

  /* pointer-following thumbnail for the post rows */
  .peek {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 120;
    width: 17.5rem;
    aspect-ratio: 3 / 2;
    margin: -5.8rem 0 0 1.5rem;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    box-shadow: 6px 6px 0 var(--ink);
  }

  @media (max-width: 899px) {
    .hero__lower,
    .feature {
      grid-template-columns: 1fr;
    }
    .hero__media {
      margin-right: calc(var(--gutter) * -1);
    }
    .hero__blog {
      bottom: -0.55em;
    }
    .hero__cue {
      display: none;
    }
    .head--split {
      grid-template-columns: 1fr;
    }
  }
</style>
