---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../lib/site';
import { CATEGORY_LABEL, formatDate, getPosts, isoDate, postUrl, readingTime, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    // posts are newest first, so the newer neighbour is the one before
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}
const { post, newer, older } = Astro.props;
const { title, date, excerpt, tldr, category, tags, race, thumbnail, thumbnailAlt, thumbnailCredit, thumbnailSource } = post.data;
const { Content } = await render(post);
const minutes = readingTime(post.body);

const url = new URL(postUrl(post), Astro.site).href;
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: excerpt,
  datePublished: date.toISOString(),
  dateModified: date.toISOString(),
  url,
  mainEntityOfPage: url,
  image: new URL(`/og/${post.id}.png`, Astro.site).href,
  keywords: tags.join(', '),
  articleSection: CATEGORY_LABEL[category],
  inLanguage: 'en',
  author: { '@type': 'Person', '@id': new URL('/#author', Astro.site).href, name: SITE.author },
  publisher: { '@id': new URL('/#author', Astro.site).href },
};
---

<BaseLayout title={title} description={excerpt} ogImage={`/og/${post.id}.png`} article={{ published: date, tags }}>
  <script type="application/ld+json" is:inline slot="head" set:html={JSON.stringify(articleLd)} />

  <article data-article>
    <header class="top on-teal" data-intro>
      <div class="wrap">
        <a href="/posts/" class="back mono" data-reveal="up">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path d="M19 12H5m6-6-6 6 6 6"></path>
          </svg>
          all posts
        </a>

        <p class="meta mono" data-reveal="stagger">
          <span class="tag">{CATEGORY_LABEL[category]}</span>
          <span>
            by <a class="by link" href={SITE.authorUrl} target="_blank" rel="noopener author">{SITE.author.toLowerCase()}</a>
          </span>
          <time datetime={isoDate(date)}>{formatDate(date)}</time>
          <span>{minutes} min read</span>
          {race && <span>{race}</span>}
        </p>

        <h1 class="title" data-split="lines">{title}</h1>
        <p class="lede" data-split="lines">{excerpt}</p>
      </div>

      {
        thumbnail && (
          <div class="wrap">
            <figure class="cover frame" data-reveal="clip">
              <Image
                src={thumbnail}
                alt={thumbnailAlt ?? ''}
                widths={[640, 1024, 1600]}
                sizes="(min-width: 1536px) 1440px, 94vw"
                loading="eager"
                fetchpriority="high"
                data-parallax="7"
              />
            </figure>
          </div>
        )
      }
    </header>

    <div class:list={['body on-paper', { 'body--cover': thumbnail }]}>
      <div class="wrap body__grid">
        <aside class="side">
          <div class="side__stick">
            <p class="mono mono--mute">filed under</p>
            <ul class="side__tags" data-reveal="stagger">
              {tags.map((tag) => <li class="tag">{tag.replace(/-/g, ' ')}</li>)}
            </ul>
            {
              thumbnailCredit && (
                <p class="mono mono--mute">
                  cover photo (cropped):{' '}
                  {thumbnailSource ? (
                    <a class="link" href={thumbnailSource} target="_blank" rel="noopener">
                      {thumbnailCredit}
                    </a>
                  ) : (
                    thumbnailCredit
                  )}
                </p>
              )
            }
          </div>
        </aside>
        <div class="prose">
          <aside class="tldr" aria-label="summary">
            <p class="tldr__label mono">tldr</p>
            <p class="tldr__text" data-split="lines">{tldr}</p>
          </aside>
          <Content />
        </div>
      </div>
    </div>
  </article>

  <nav class="around on-deep" aria-label="more posts">
    {
      [
        { post: newer, label: 'newer post' },
        { post: older, label: 'older post' },
      ].map(
        ({ post: p, label }) =>
          p && (
            <a href={postUrl(p)} class="around__link" data-fill data-cursor="read">
              <span class="fill" aria-hidden="true" />
              <span class="mono">{label}</span>
              <span class="around__title" data-split="lines">{p.data.title}</span>
              <span class="mono around__date">{formatDate(p.data.date)}</span>
            </a>
          ),
      )
    }
  </nav>
</BaseLayout>

<style>
  .top {
    padding-top: calc(var(--header-h) + clamp(3rem, 7vw, 7rem));
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    /* a full-height tap target that takes up no more room than the label did */
    min-height: 2.75rem;
    margin-block: -0.5rem;
    color: var(--mute);
    transition: color 0.2s, gap 0.3s var(--ease-out);
  }
  .back:hover {
    color: var(--fg);
    gap: 1rem;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1.25rem;
    margin-top: clamp(2rem, 4vw, 3.5rem);
    color: var(--mute);
  }
  .meta .tag {
    color: var(--accent-text);
  }
  .by {
    color: var(--fg);
    transition:
      color 0.2s,
      background-size 0.35s var(--ease-out);
  }
  .by:hover {
    color: var(--accent-text);
  }
  .title {
    max-width: 18ch;
    margin-top: 1.5rem;
    font-size: clamp(2.3rem, 6.4vw, 6.75rem);
    line-height: 0.95;
    letter-spacing: -0.045em;
  }
  .top .lede {
    max-width: 34ch;
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    padding-bottom: clamp(3rem, 6vw, 6rem);
    color: var(--mute);
  }

  /* the cover straddles the teal header and the paper body */
  .cover {
    aspect-ratio: 16 / 8;
    margin-bottom: clamp(-12rem, -12vw, -4rem);
    border-color: var(--paper);
    box-shadow: 10px 10px 0 var(--lime);
    z-index: 1;
  }
  .cover :global(img) {
    position: absolute;
    top: -8%;
    left: 0;
    height: 116%;
  }

  .body {
    padding-block: clamp(3.5rem, 7vw, 7rem) clamp(5rem, 10vw, 10rem);
  }
  .body--cover {
    padding-top: calc(clamp(4rem, 12vw, 12rem) + clamp(3rem, 6vw, 6rem));
  }
  .body__grid {
    display: grid;
    grid-template-columns: minmax(0, 15rem) minmax(0, 44rem);
    gap: clamp(2rem, 6vw, 7rem);
  }
  .side__stick {
    position: sticky;
    top: calc(var(--header-h) + 3rem);
    display: grid;
    gap: 0.9rem;
    padding-top: 0.6rem;
    border-top: var(--rule) solid var(--ink);
  }
  .side__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  /* the summary box borrows the cover's hard lime shadow */
  .tldr {
    margin-bottom: 2.4rem;
    padding: 1.1rem 1.25rem 1.3rem;
    border: var(--rule) solid var(--ink);
    background: var(--paper-dim);
    box-shadow: 6px 6px 0 var(--lime);
  }
  .tldr__label {
    display: inline-block;
    margin-bottom: 0.75rem;
    padding: 0.3rem 0.5rem;
    background: var(--ink);
    color: var(--paper);
  }
  .tldr__text {
    font-family: var(--font-display);
    font-size: clamp(1rem, 0.95rem + 0.2vw, 1.125rem);
    font-weight: 560;
    line-height: 1.42;
    letter-spacing: -0.012em;
  }

  .around {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
  }
  .around__link {
    position: relative;
    display: grid;
    gap: 1rem;
    align-content: start;
    padding: clamp(2rem, 5vw, 5rem) var(--gutter);
    border-top: 1px solid var(--line);
    overflow: hidden;
    isolation: isolate;
    transition: color 0.3s var(--ease-out);
  }
  .around__link + .around__link {
    border-left: 1px solid var(--line);
  }
  .around__link .fill {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--lime);
    transform: translateY(101%);
  }
  .around__link:hover,
  .around__link:focus-visible {
    color: var(--ink);
  }
  .around__link:focus-visible .fill {
    transform: none;
  }
  .around__link .mono {
    color: var(--mute);
    transition: color 0.3s var(--ease-out);
  }
  .around__link:hover .mono {
    color: var(--ink);
  }
  .around__title {
    max-width: 20ch;
    font-weight: 880;
    font-stretch: 110%;
    font-size: clamp(1.6rem, 3vw, 2.9rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  @media (max-width: 899px) {
    .body__grid {
      grid-template-columns: 1fr;
    }
    .side {
      order: 2;
    }
    .side__stick {
      position: static;
    }
    .cover {
      aspect-ratio: 3 / 2;
    }
  }
</style>
