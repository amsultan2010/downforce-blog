---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostRow from '../../components/PostRow.astro';
import { CATEGORY_PLURAL, getPosts, type Category } from '../../lib/posts';

const posts = await getPosts();
const cats = (['race-report', 'sprint-report', 'editorial', 'guide', 'paddock', 'meta'] as Category[])
  .map((cat) => ({ cat, count: posts.filter((p) => p.data.category === cat).length }))
  .filter((c) => c.count > 0);
---

<BaseLayout
  title="all posts"
  description={`every post on the downforce blog: ${posts.length} race reports, sprint reports, editorials and guides on formula 1.`}
>
  <section class="top on-teal" data-intro>
    <div class="wrap">
      <p class="eyebrow mono" data-reveal="up">the archive</p>
      <h1 class="h-xl display" data-split="chars">all <span class="serif-accent">posts</span></h1>
      <div class="top__row">
        <p class="lede" data-split="lines">
          <span data-shown>{posts.length}</span> posts, newest first. filter by type, or let the site pick one for you.
        </p>
        <div data-reveal="stagger">
          <button class="btn btn--accent" type="button" data-random data-magnetic>random post</button>
        </div>
      </div>
    </div>
  </section>

  <section class="list on-paper">
    <div class="wrap">
      <div class="filters" role="group" aria-label="filter posts by type" data-reveal="stagger">
        <button class="filter mono" type="button" data-filter="all" aria-pressed="true">
          all <span>{posts.length}</span>
        </button>
        {
          cats.map(({ cat, count }) => (
            <button class="filter mono" type="button" data-filter={cat} aria-pressed="false">
              {CATEGORY_PLURAL[cat]} <span>{count}</span>
            </button>
          ))
        }
      </div>

      <ol class="plist" data-plist>
        {posts.map((post) => <PostRow post={post} excerpt />)}
      </ol>
    </div>
  </section>

  <div class="peek frame" data-peek-box aria-hidden="true"><img alt="" width="280" height="187" /></div>
</BaseLayout>

<style>
  .top {
    padding-top: calc(var(--header-h) + clamp(4rem, 9vw, 9rem));
    padding-bottom: clamp(3rem, 6vw, 6rem);
  }
  .top .eyebrow {
    margin-bottom: 1.5rem;
  }
  .top__row {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-top: clamp(2rem, 4vw, 4rem);
  }
  .top__row .lede {
    max-width: 30ch;
  }

  .list {
    padding-block: clamp(2.5rem, 5vw, 5rem) clamp(5rem, 10vw, 10rem);
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    margin-bottom: clamp(1.5rem, 3vw, 3rem);
    border: var(--rule) solid var(--ink);
    width: fit-content;
    max-width: 100%;
  }
  .filter {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 1.1rem;
    font-size: 0.8125rem;
    border-right: var(--rule) solid var(--ink);
    margin-right: -2px;
    transition:
      background-color 0.25s var(--ease-out),
      color 0.25s var(--ease-out);
  }
  .filter span {
    color: var(--mute);
    transition: color 0.25s var(--ease-out);
  }
  .filter:hover {
    background: var(--paper-dim);
  }
  .filter:active {
    background: var(--lime);
  }
  .filter[aria-pressed='true'] {
    background: var(--ink);
    color: var(--paper);
  }
  .filter[aria-pressed='true'] span {
    color: var(--lime);
  }

  .plist {
    position: relative;
    border-top: var(--rule) solid var(--ink);
  }

  .peek {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 120;
    width: 17.5rem;
    aspect-ratio: 3 / 2;
    margin: -5.8rem 0 0 1.5rem;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    box-shadow: 6px 6px 0 var(--ink);
  }
</style>
